[Desktop Entry]
Type=Application
Name=System Update
Name[fr]=Mises à jour système
Comment=Update system, Flatpaks, containers and brew
Comment[fr]=Mettre à jour le système, les Flatpaks, Homebrew et les conteneurs
Icon=/usr/share/ublue-os/icons/update.svg
Categories=System;Utility;
Terminal=false
Exec=/usr/bin/ptyxis -s -T "Mises à jour Bazzora" -- /usr/bin/bash -lc "ujust bazzora-update; read -rp 'Appuyez sur Entrée pour fermer…'"
